#!/usr/bin/env bash
# Sentinel AI pre-commit hook: secret scan -> format -> vet -> tests.
# Enable once per clone with:  make hooks
# The secret scan is fail-closed: if gitleaks is missing, the commit is blocked.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

step() { printf '\n\033[1mpre-commit:\033[0m %s\n' "$1"; }

step "scanning staged changes for secrets (gitleaks)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed; refusing to commit without a secret scan." >&2
  echo "Install it: https://github.com/gitleaks/gitleaks#installing (e.g. brew install gitleaks)" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml .

staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
if [[ -z "$staged_go" ]]; then
  exit 0
fi

step "checking formatting"
# shellcheck disable=SC2086 # word splitting is intended; Go file names contain no spaces
unformatted=$(gofmt -l $staged_go)
if [[ -n "$unformatted" ]]; then
  echo "These files need gofmt:" >&2
  echo "$unformatted" >&2
  exit 1
fi

step "go vet"
go vet ./...

step "go test"
go test -short ./...
