# Sentinel AI Code Reviewer — example configuration.
#
# For local development:   cp .env.example .env   then fill in real values.
# .env is git-ignored. NEVER put real credentials in this file.
# In GitHub Actions these values come from repository secrets, not from a file.

# --- Required ----------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
GITHUB_TOKEN=your_github_token

# Pull request to review. GITHUB_REPOSITORY is set automatically in GitHub Actions.
GITHUB_REPOSITORY=example-org/example-repository
PR_NUMBER=1

# --- Optional (defaults shown) -----------------------------------------------
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60s
GITHUB_API_URL=https://api.github.com

MIN_CONFIDENCE=0.75
MAX_AGENT_STEPS=10
AGENT_TIMEOUT=5m

# Path of the checked-out repository under review.
REPO_PATH=.
# When true, the review is printed instead of published to the pull request.
DRY_RUN=true

LOG_LEVEL=info
LOG_FORMAT=text

# --- Reserved for future stages (not read yet) -------------------------------
# GITHUB_WEBHOOK_SECRET=your_webhook_secret
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=sentinel
# DATABASE_USER=sentinel
# DATABASE_PASSWORD=change_me
